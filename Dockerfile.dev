# =============================================================================
# Built Ox API - Development Dockerfile
# Simple setup with built-in PHP server for local development
# =============================================================================

FROM php:8.4-cli-alpine

WORKDIR /var/www/html

# Install system dependencies
RUN apk update && apk add --no-cache \
    git \
    curl \
    libpq-dev \
    libzip-dev \
    oniguruma-dev \
    && rm -rf /var/cache/apk/*

# Install PHP extensions
RUN docker-php-ext-install \
    pdo_pgsql \
    pgsql \
    mbstring \
    zip \
    opcache \
    bcmath

# The repo is bind-mounted from the host during local development, so mark it
# as safe for git-based Composer checks inside the container.
RUN git config --global --add safe.directory /var/www/html

# Install Composer
COPY --from=composer:2.8 /usr/bin/composer /usr/bin/composer

# Copy composer files and install dependencies
COPY composer.json composer.lock ./
RUN composer install --no-scripts --no-autoloader

# Expose port
EXPOSE 8000

# Entrypoint that installs deps and starts the PHP built-in server directly.
# Using `php artisan serve` inside Docker can spawn a child process that does
# not consistently honor the container's runtime environment overrides.
CMD composer install && php artisan optimize:clear >/dev/null 2>&1 && cd public && php -S 0.0.0.0:8000 ../vendor/laravel/framework/src/Illuminate/Foundation/resources/server.php
